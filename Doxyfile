PROJECT_NAME           = "aio"
PROJECT_BRIEF          = "All-In-One Pygame Launcher - discover and launch every public pygame game (CLI, TUI, GUI, WUI, Tray)"
PROJECT_NUMBER         = "0.1.0"
OUTPUT_DIRECTORY       = docs
INPUT                  = aio.py docs/mainpage.md docs/commands.md docs/api.md docs/architecture.md docs/INDEX.md README.md
FILE_PATTERNS          = *.py *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */__pycache__/* */venv/* */docs/html/*
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
USE_MDFILE_AS_MAINPAGE = docs/mainpage.md
SOURCE_BROWSER         = YES
WARN_IF_UNDOCUMENTED   = NO
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
